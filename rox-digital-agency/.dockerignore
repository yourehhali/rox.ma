# Docker build context exclusions for the TanStack Start / Nitro frontend.
# Keep this in sync with .gitignore, plus Docker-specific noise.

# Dependencies & build artifacts (rebuilt inside the image)
node_modules
dist
dist-ssr
.output
.vinxi
.nitro
.wrangler
.tanstack
.vercel
.netlify

# Local env / secrets — never bake these into the image.
# VITE_API_URL is passed as a build ARG instead.
.env
.env.*
!.env.example

# Logs, caches, OS junk
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.DS_Store
.vscode
.idea
coverage
.eslintcache

# Git metadata (repo not required at build time)
.git
.gitignore

# Dockerfiles themselves
Dockerfile
Dockerfile.*
docker-compose*.yml
.dockerignore
