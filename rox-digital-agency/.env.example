# Base URL of the rox-api backend. No trailing slash — it's stripped anyway.
#
# Backend running locally (mvn spring-boot:run or `docker compose up` in the
# repo root) listens on 8090, so use:
VITE_API_URL=http://localhost:8090
#
# Prod / Dokploy: pass as a build ARG instead (Vite inlines this at build time):
#   VITE_API_URL=https://api.rox.ma
#
# Dev server notes: Vite/TanStack defaults to :8080 and auto-increments to
# :8081/:8082/:8083 when busy — those origins are already in the backend's
# CORS_ALLOWED_ORIGINS default list.
