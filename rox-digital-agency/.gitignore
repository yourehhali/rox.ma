# =============================================================================
# rox-digital-agency (TanStack Start / Vite / Nitro)
# =============================================================================

# Dependencies & build artifacts
node_modules/
dist/
dist-ssr/
.output/
.vinxi/
.nitro/
.tanstack/**
*.local

# Test / coverage
coverage/
.nyc_output/
*.tsbuildinfo

# Wrangler / Cloudflare (kept for historical reasons — build uses nitro node-server now)
.wrangler/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
bun-debug.log*
lerna-debug.log*

# Secrets — VITE_API_URL is a build ARG, never a committed secret.
.env
.env.*
!.env.example
.dev.vars

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS
.DS_Store

# Large media files — kept local only, never committed.
# NOTE: public/hero-bg.mp4 is the H.264 fallback source in the hero <video>; it is
# intentionally ignored, so builds made from the git repo won't ship it (only the
# committed hero-bg.webm will). Old browsers without WebM/VP9 get no video there.
*.mp4
*.m4v
*.mov
