# Copy to .env (or export in your shell) — read by Spring Boot at runtime.
# These are the canonical names used by docker-compose.yml; Spring also accepts
# the SPRING_DATASOURCE_* forms below for plain local (`mvn spring-boot:run`) use.
DATABASE_URL=jdbc:postgresql://localhost:5432/rox_api
DATABASE_USER=rox
DATABASE_PASSWORD=rox
# Spring relaxed-binding equivalents (either style works locally):
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/rox_api
SPRING_DATASOURCE_USERNAME=rox
SPRING_DATASOURCE_PASSWORD=rox
# 64 random bytes base64. Generate:  openssl rand -base64 64
JWT_SECRET=please_replace_me_with_a_strong_random_secret_at_least_32_bytes_long
# Backend HTTP port. 8090 leaves 8080 free for Vite dev.
SERVER_PORT=8090
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=30
CORS_ALLOWED_ORIGINS=https://rox.ma,http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:8083

# Seed data (idempotent — only inserts when the target table is empty).
# Set to false to skip DataSeeder entirely once you've curated your DB.
ROX_SEED_ENABLED=true
# Initial admin — used only when admin_account is empty AND ROX_SEED_ENABLED=true.
ROX_SEED_ADMIN_EMAIL=admin@rox.ma
ROX_SEED_ADMIN_PASSWORD=rox-admin

# Portfolio media uploads: on-disk root (relative to CWD) served at /uploads/**.
ROX_UPLOAD_DIR=./uploads
ROX_UPLOAD_MAX_BYTES=5242880

# Optional Google Gemini free-tier key — quality-first AI provider: portfolio
# "Remplir avec l'IA" helper + order-triage fallback. Free key:
# https://aistudio.google.com/apikey. Google free-tier limits are per project
# (RPM/TPM/RPD, RPD resets midnight Pacific); GEMINI_DAILY_LIMIT is our own
# safety budget shown in the admin UI, and GEMINI_MAX_OUTPUT_TOKENS caps each
# reply so the quota lasts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_DAILY_LIMIT=50
GEMINI_MAX_OUTPUT_TOKENS=700
# ROX_RATE_LIMIT_AI_DRAFT_PER_MIN=4

# New-order AI triage (verdict + Lovable/Trae UI prompt, WhatsApp alert when the
# brief needs admin follow-up). Runs Cloudflare-first to save the Gemini budget.
GEMINI_ORDER_PROMPT_ENABLED=true
GEMINI_ORDER_MAX_OUTPUT_TOKENS=1100

# Optional Cloudflare Workers AI free tier (10k Neurons/day, no card) — bulk
# provider for order triage + failover for portfolio drafts. Cloudflare
# dashboard → Workers AI → Account ID + API token ("Workers AI: Read and Write").
# Leave empty to stay Gemini-only. Empty MODEL → @cf/meta/llama-3.1-8b-instruct.
CLOUDFLARE_AI_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
CLOUDFLARE_AI_MODEL=
CLOUDFLARE_AI_DAILY_LIMIT=100
